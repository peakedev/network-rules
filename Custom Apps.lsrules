            "remote-addresses" : [
                "17.248.250.10",
                "151.101.3.6"
            ]
        },
        {
            "action" : "allow",
            "notes" : "Safari",
            "process" : "identifier.APPLE/com.apple.Safari",
            "remote" : "any"
        },
        {
            "action" : "allow",
            "notes" : "Terminal via curl - engie",
            "process" : "identifier.APPLE/com.apple.Terminal",
            "remote-domains" : "engie.be",
            "via" : "identifier.APPLE/com.apple.curl"
        },
        {
            "action" : "allow",
            "notes" : "Terminal via curl - influxdata",
            "process" : "identifier.APPLE/com.apple.Terminal",
            "remote-domains" : "influxdata.com",
            "via" : "identifier.APPLE/com.apple.curl"
        },
        {
            "action" : "allow",
            "notes" : "Terminal via gh - GitHub access",
            "process" : "identifier.APPLE/com.apple.Terminal",
            "remote-domains" : "github.com",
            "via" : "path.opt/homebrew/Cellar/gh/*/bin/gh"
        },
        {
            "action" : "allow",
            "notes" : "Terminal via Python 3.14 - development",
            "process" : "identifier.APPLE/com.apple.Terminal",
            "remote-domains" : [
                "github.com",
                "pypi.org",
                "pythonhosted.org"
            ],
            "via" : "path.opt/homebrew/Cellar/python@3.14/*/Frameworks/Python.framework/Versions/3.14/Resources/Python.app/Contents/MacOS/Python"
        },
        {
            "action" : "allow",
            "notes" : "Terminal via Python 3.14 - local network",
            "process" : "identifier.APPLE/com.apple.Terminal",
            "remote-addresses" : "192.168.1.254",
            "via" : "path.opt/homebrew/Cellar/python@3.14/*/Frameworks/Python.framework/Versions/3.14/Resources/Python.app/Contents/MacOS/Python"
        },
        {
            "action" : "allow",
