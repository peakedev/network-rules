{
    "description": "Trusted domains for all apps/processes",
    "name": "Trusted Domains",
    "rules": [
        {
            "action": "allow",
            "notes": "Microsoft / Office 365 / Azure",
            "remote-domains": [
                "appcenter.ms",
                "azurefd.net",
                "cloud.microsoft",
                "live.com",
                "microsoft.com",
                "microsoftonline.com",
                "msauth.net",
                "msftauth.net",
                "msftauthimages.net",
                "office.com",
                "office.net",
                "office365.com",
                "outlook.com",
                "sfx.ms",
                "sharepoint.com",
                "sharepointonline.com",
                "skype.com",
                "static.microsoft",
                "windows.com",
                "windows.net"
            ]
        },
        {
            "action": "allow",
            "notes": "Google Services",
            "remote-domains": [
                "dns.google",
                "gcr.io",
                "gmail.com",
                "google.com",
                "googleapis.com",
                "googleusercontent.com",
                "gstatic.com",
                "gvt1.com"
            ]
        },
        {
            "action": "allow",
            "notes": "OVH Services",
            "remote-domains": [
                "ovh.net"
            ]
        },
        {
            "action": "allow",
            "notes": "Adobe Creative Cloud & Services",
            "remote-domains": [
                "acrobat.com",
                "adobe.com",
                "adobe.io",
                "adobecc.com",
                "adobecces.com",
                "adobeccstatic.com",
                "adobedc.net",
                "adobedtm.com",
                "adobelogin.com",
                "adobeoobe.com",
                "adobesc.com",
                "adobess.com",
                "astockcdn.net",
                "omtrdc.net",
                "substance3d.com",
                "typekit"
            ]
        },
        {
            "action": "allow",
            "notes": "GitHub",
            "remote-domains": [
                "github.com",
                "githubusercontent.com"
            ]
        },
        {
            "action": "allow",
            "notes": "Apple",
            "remote-domains": [
                "apple",
                "apple-cloudkit.com",
                "apple-mapkit.com",
                "apple.com",
                "apple.news",
                "cdn-apple.com",
                "icloud-content.com",
                "icloud.com",
                "me.com",
                "mzstatic.com"
            ]
        },
        {
            "action": "allow",
            "notes": "DocuSign",
            "remote-domains": [
                "docucdn-a.akamaihd.net",
                "docusign.net"
            ]
        },
        {
            "action": "allow",
            "notes": "Notion",
            "remote-domains": [
                "notion-static.com",
                "notion.so",
                "notionusercontent.com"
            ]
        },
        {
            "action": "allow",
            "notes": "Spotify",
            "remote-domains": [
                "scdn.co",
                "spotify.com",
                "spotifycdn.com"
            ]
        },
        {
            "action": "allow",
            "notes": "SoundCloud",
            "remote-domains": [
                "sndcdn.com",
                "soundcloud.cloud",
                "soundcloud.com"
            ]
        },
        {
            "action": "allow",
            "notes": "Hyfen domains",
            "remote-domains": [
                "hfyen.nl",
                "hyfen.cloud",
                "hyfen.eu"
            ]
        },
        {
            "action": "allow",
            "notes": "Trustup domains",
            "remote-domains": [
                "trustup.group",
                "trustup.be"
            ]
        },
        {
            "action": "allow",
            "notes": "Development tools",
            "remote-domains": [
                "brew.sh",
                "pypi.org",
                "responsively.app",
                "simplesvg.com",
                "supabase.co",
                "todesktop.com",
                "trivy.dev",
                "linear.app"
            ]
        },
        {
            "action": "allow",
            "notes": "Certificate authorities",
            "remote-domains": [
                "digicert.com",
                "eurocert.pl"
            ]
        },
        {
            "action": "allow",
            "notes": "Monitoring & Analytics",
            "remote-domains": [
                "acompli.net",
                "nr-data.net"
            ]
        },
        {
            "action": "allow",
            "notes": "Networking & VPN",
            "remote-domains": [
                "openvpn.net",
                "ui.com"
            ]
        },
        {
            "action": "allow",
            "notes": "Little Snitch (obdev)",
            "remote-domains": "obdev.at"
        },
        {
            "action": "allow",
            "notes": "iStat Menus",
            "remote-domains": "istatmenus.app"
        },
        {
            "action": "allow",
            "notes": "Belgian services",
            "remote-domains": [
                "eboxenterprise.be",
                "peake.be"
            ]
        },
        {
            "action": "allow",
            "notes": "Legitimate Microsoft services IP Range",
            "remote-addresses": "2603:1063::-2603:1063:1ff:ffff:ffff:ffff:ffff:ffff"
        },
        {
            "action": "allow",
            "notes": "Azure metadata IP",
            "remote-addresses": "168.63.129.16"
        },
        {
            "action": "allow",
            "direction": "both",
            "notes": "Local network",
            "remote": "local-net"
        },
        {
            "action": "allow",
            "direction": "incoming",
            "notes": "ICMP ping",
            "protocol": "icmp",
            "remote": "any"
        },
        {
            "action": "deny",
            "notes": "Blocked telemetry",
            "remote-domains": "sentry.io"
        }
    ]
}
